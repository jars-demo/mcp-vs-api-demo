# Your Groq API key — get one free at https://console.groq.com/keys
# This key stays on the server. It is never sent to the browser.
GROQ_API_KEY=

# Any Groq model that supports tool calling.
# See https://console.groq.com/docs/models for the current list.
GROQ_MODEL=llama-3.3-70b-versatile

# Where the MCP server is listening (see mcp-server/.env).
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# Port for this FastAPI backend.
BACKEND_PORT=8000
