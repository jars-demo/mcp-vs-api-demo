# ─────────────────────────────────────────────────────────────
#  Reference only — this root file is NOT read by any service.
#
#  Each service reads its own .env file:
#    backend/.env      ← copied from backend/.env.example
#    mcp-server/.env   ← copied from mcp-server/.env.example
#
#  `python setup.py` creates both for you.
# ─────────────────────────────────────────────────────────────

# backend/.env
GROQ_API_KEY=                               # https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile          # any Groq model that supports tool calling
MCP_SERVER_URL=http://127.0.0.1:8001/mcp    # where the MCP server listens
BACKEND_PORT=8000

# mcp-server/.env
MCP_HOST=127.0.0.1
MCP_PORT=8001
