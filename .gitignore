.env
.env.*
!.env.example

# ── Python ─────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Node / Vite ────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
.vite/

# ── Editors & OS ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ── Logs ───────────────────────────────────────────────
*.log
npm-debug.log*
